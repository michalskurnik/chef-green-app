{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/site/(.*)",
      "dest": "/site/$1"
    },
    {
      "src": "/(robots\\.txt|sitemap\\.xml)",
      "has": [
        {
          "type": "host",
          "value": "greenchef.foodgames.co.il"
        }
      ],
      "dest": "/site/$1"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "greenchef.foodgames.co.il"
        }
      ],
      "dest": "/site/index.html"
    },
    {
      "src": "/(workshops|accessibility|birthdays)",
      "has": [
        {
          "type": "host",
          "value": "greenchef.foodgames.co.il"
        }
      ],
      "dest": "/site/$1.html"
    },
    {
      "src": "/greenchef",
      "headers": {
        "Location": "/greenchef/"
      },
      "status": 301
    },
    {
      "src": "/greenchef/",
      "dest": "/site/index.html"
    },
    {
      "src": "/greenchef/(workshops|accessibility|birthdays)",
      "dest": "/site/$1.html"
    },
    {
      "src": "/",
      "dest": "/app/start.html",
      "status": 302
    },
    {
      "src": "^/(italy|dinner)$",
      "headers": {
        "Location": "/$1/"
      },
      "status": 301
    },
    {
      "src": "/(.*)",
      "dest": "/www/$1"
    }
  ]
}

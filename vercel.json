{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/",
      "dest": "/app/start.html",
      "status": 302
    },
    {
      "src": "^/(italy|dinner)$",
      "headers": { "Location": "/$1/" },
      "status": 301
    },
    {
      "src": "/(.*)",
      "dest": "/www/$1"
    }
  ]
}

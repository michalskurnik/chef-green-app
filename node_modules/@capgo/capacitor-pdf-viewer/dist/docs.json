          "name": "toBack",
          "tags": [
            {
              "text": "false",
              "name": "default"
            },
            {
              "text": "android, ios",
              "name": "platform"
            },
            {
              "text": "8.0.0",
              "name": "since"
            }
          ],
          "docs": "Shorthand for `mode: 'underWebView'`. When true, the native PDF is placed behind a transparent WebView\nso your HTML controls sit on top. Implies `nativeUi: false`.\n\nOn web, `toBack: true` and `mode: 'underWebView'` are rejected.",
          "complexTypes": [],
          "type": "boolean | undefined"
        },
        {
          "name": "nativeUi",
          "tags": [
            {
              "text": "8.0.0",
              "name": "since"
            }
          ],
          "docs": "When false, hides all native chrome (close button, toolbars). Defaults to false when `toBack` or\n`mode` is `underWebView`, otherwise true for fullscreen.\n\nOn web, `nativeUi: false` with `mode: 'fullscreen'` is rejected. Use `inline` mode with `elementId`,\nor keep `nativeUi` enabled.",
          "complexTypes": [],
          "type": "boolean | undefined"
        },

            "name": "since",
            "text": "8.0.0"
          },
          {
            "name": "example",
            "text": "```typescript\nconst result = await PdfViewer.open({\n  source: 'https://example.com/manual.pdf',\n  headers: { Authorization: 'Bearer token' },\n  mode: 'fullscreen',\n});\n```"
          }
        ],
        "docs": "Open a PDF from a file, path, URL, or base64 source.",

          }
        ],
        "docs": "Move to the next page when one exists.\n\nOn web the browser PDF viewer does not report total pages, so {@link PdfViewerPlugin.getPageCount}\nstays at `1` and this method cannot advance past page `1` unless you call {@link PdfViewerPlugin.goToPage}\nwith a higher page number yourself.",
        "complexTypes": [],
        "slug": "nextpage"
      },
      {
        "name": "previousPage",
        "signature": "() => Promise<void>",
        "parameters": [],
        "returns": "Promise<void>",
        "tags": [
          {
            "name": "since",
            "text": "8.0.0"
          }
        ],
        "docs": "Move to the previous page when one exists.\n\nOn web, page navigation follows the same limitations as {@link PdfViewerPlugin.nextPage}.",
        "complexTypes": [],
        "slug": "previouspage"
      },
      {
        "name": "setZoom",
